[user]
	# User configuration
	name = Callum White
	email = callumw1991@gmail.com

[github]
	user = cwhitey

[diff]
	mnemonicPrefix = true
	wordRegex = "[^[:space:]]|([[:alnum:]]|UTF_8_GUARD)+"

[color]
	ui = auto

[color "grep"]
	match = cyan bold
	selected = blue
	context = normal
	filename = magenta
	linenumber = green
	separator = yellow
	function = blue

[pretty]
	line = "%C(auto)%h%d %s %C(yellow)by %C(blue)%an %C(green)%ar"
	compact = "%C(auto)%h %s %C(green)%ar%n %C(auto)%d%n"
	detail = "%C(auto)%h %s%n  %C(yellow)by %C(blue)%an %C(magenta)<%ae> [%G?] %C(green)%ar%n %C(auto)%d%n"

[merge]
	defaultToUpstream = true

[mergetool]
	keepBackup = false

[push]
	default = simple

[credential]
	helper = cache --timeout=3600

[grep]
	lineNumber = true

[advice]
	detachedHead = false

[core]
	excludesfile = ~/.gitignore

# Allow local customizations in the .gitconfig_local file
[include]
	path = ~/.gitconfig_local
[magithub]
	online = false
[magithub "status"]
	includeStatusHeader = false
	includePullRequestsSection = false
	includeIssuesSection = false
