{:tasks
 {link
  {:doc "Link dotfiles and clean broken links (--dry-run to preview)"
   :task (apply shell "bb" "link/link.clj" *command-line-args*)}

  deps
  {:doc "Install the full Homebrew package, app, and VS Code extension profile"
   :task (shell "brew bundle --file=modules/osx/Brewfile")}

  shell:install
  {:doc "Install missing Zsh plugins and rebuild the Zim loader"
   :task (shell "zsh -f modules/zsh/scripts/plugins.zsh install")}

  shell:update
  {:doc "Update Zsh plugins and rebuild the Zim loader"
   :task (shell "zsh -f modules/zsh/scripts/plugins.zsh update")}

  setup
  {:doc "Set up a new Mac after Homebrew and Babashka are installed"
   :depends [deps link shell:install]}}}
